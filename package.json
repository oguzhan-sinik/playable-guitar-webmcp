{
  "name": "playable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "guitar": "./src/cli/index.ts"
  },
  "scripts": {
    "guitar": "tsx src/cli/index.ts",
    "demo": "lsof -ti :3847 | xargs kill 2>/dev/null; tsx src/demo/server.ts",
    "build:web": "node_modules/esbuild/bin/esbuild src/demo/client.ts --bundle --format=esm --outfile=demo/app.js",
    "build": "pnpm build:web",
    "start": "tsx src/demo/server.ts",
    "demo:all": "pnpm build && lsof -ti :3847 | xargs kill 2>/dev/null; tsx src/demo/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "commander": "^15.0.0",
    "essentia.js": "^0.1.3",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
